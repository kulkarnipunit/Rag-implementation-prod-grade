# -----------------------------------------------------------------
# LLM Provider — switch without touching any code
# -----------------------------------------------------------------
# Options: ollama | claude | openai
LLM_PROVIDER=ollama

# --- Ollama (local Mac or remote server) ---
OLLAMA_HOST=http://localhost:11434
# To use a remote machine: OLLAMA_HOST=http://192.168.1.50:11434
OLLAMA_MODEL=llama3

# --- Claude (Anthropic API) ---
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=your_key_here
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- OpenAI-compatible (vLLM / LM Studio / Groq / Together AI) ---
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://192.168.1.50:8000/v1
# OPENAI_API_KEY=not-needed
# OPENAI_MODEL=mistral-7b

# -----------------------------------------------------------------
# Vector store
# -----------------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db

# -----------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------
TOP_K_RESULTS=15
RELEVANCE_THRESHOLD=0.4
EXHAUSTIVE_TOP_K=30

# -----------------------------------------------------------------
# Agent
# -----------------------------------------------------------------
MAX_TOKENS=8192
MAX_RETRIES=2
