ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vector store config
CHROMA_PERSIST_DIR=./chroma_db

# Embedding model (local sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval config
TOP_K_RESULTS=5
RELEVANCE_THRESHOLD=0.4

# LLM config
CLAUDE_MODEL=claude-opus-4-8
MAX_TOKENS=8192

# Async worker concurrency
WORKER_CONCURRENCY=3

# Crash recovery
JOB_TIMEOUT_SECONDS=300    # job stuck in "processing" longer than this → assumed crashed
MAX_RETRIES=3              # how many times to retry a crashed job before giving up
REAPER_INTERVAL_SECONDS=30 # how often the reaper scans for stuck jobs
