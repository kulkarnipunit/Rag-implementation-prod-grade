ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vector store config
CHROMA_PERSIST_DIR=./chroma_db

# Embedding model (local sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval config
TOP_K_RESULTS=5
RELEVANCE_THRESHOLD=0.4

# LLM config
CLAUDE_MODEL=claude-opus-4-8
MAX_TOKENS=8192
